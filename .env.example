# SentinelX Environment Variables Template (Copy to .env)

# --- AI Provider API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
XAI_API_KEY=your_xai_grok_key_here
EXA_API_KEY=your_exa_search_key_here
OPENAI_API_KEY=your_openai_key_here

# Default Provider: gemini | grok | openai
AI_PROVIDER=gemini

# --- Backend Configuration ---
PORT=8000
DATABASE_URL=sqlite:///./sentinelx.db

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live
